{
  "id": "BookingSimul8tor",
  "name": "Booking simulator",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Tbilisi"
  },
  "nodes": [
    {
      "id": "8d2f6c1e-1a3b-4c5d-9e0f-000000000001",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "8d2f6c1e-1a3b-4c5d-9e0f-000000000002",
      "name": "Plan the visit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300],
      "parameters": {
        "jsCode": "const apiBaseUrl = 'http://host.docker.internal:8000/api/v1';\nconst botCount = 4;\nconst daysAhead = 7;\nconst dayMs = 24 * 60 * 60 * 1000;\nconst pick = (count) => Math.floor(Math.random() * count);\nconst restaurantDate = (ms) =>\n  new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Tbilisi' }).format(new Date(ms));\n\nreturn [\n  {\n    json: {\n      apiBaseUrl,\n      email: `booking-bot-${pick(botCount) + 1}@example.com`,\n      date: restaurantDate(Date.now() + pick(daysAhead + 1) * dayMs),\n      partySize: pick(4) + 1,\n      action: Math.random() < 0.2 ? 'cancel' : 'book',\n    },\n  },\n];"
      }
    },
    {
      "id": "8d2f6c1e-1a3b-4c5d-9e0f-000000000003",
      "name": "Log in",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300],
      "credentials": {
        "httpCustomAuth": {
          "id": "BookingBotPasswd",
          "name": "Booking bot password"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiBaseUrl }}/auth/login",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email: $json.email }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      }
    },
    {
      "id": "8d2f6c1e-1a3b-4c5d-9e0f-000000000004",
      "name": "Keep the session",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300],
      "parameters": {
        "jsCode": "const plan = $('Plan the visit').first().json;\nconst setCookie = [].concat($input.first().json.headers['set-cookie'] ?? []);\nconst cookie = setCookie.map((header) => header.split(';')[0]).join('; ');\n\nreturn [{ json: { ...plan, cookie } }];"
      }
    },
    {
      "id": "8d2f6c1e-1a3b-4c5d-9e0f-000000000005",
      "name": "Book this time?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 200],
      "parameters": {
        "jsCode": "const visit = $input.first().json;\n\nreturn visit.action === 'book' ? [{ json: visit }] : [];"
      }
    },
    {
      "id": "8d2f6c1e-1a3b-4c5d-9e0f-000000000006",
      "name": "Search tables",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 200],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.apiBaseUrl }}/bookings/tables",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "date",
              "value": "={{ $json.date }}"
            },
            {
              "name": "party_size",
              "value": "={{ $json.partySize }}"
            },
            {
              "name": "limit",
              "value": "50"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "8d2f6c1e-1a3b-4c5d-9e0f-000000000007",
      "name": "Pick a free slot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 200],
      "parameters": {
        "jsCode": "// Leave real guests a choice: book only where at least this many fitting tables are free\n// at one location and one start time.\nconst minFreeTables = 4;\nconst visit = $('Book this time?').first().json;\nconst pick = (list) => list[Math.floor(Math.random() * list.length)];\n\nconst freeTablesByStart = new Map();\nfor (const table of $input.first().json.items) {\n  for (const slot of table.slots.filter((slot) => slot.available)) {\n    const key = `${table.location.id}|${slot.starts_at}`;\n    const entry = freeTablesByStart.get(key) ?? { startsAt: slot.starts_at, tableIds: [] };\n    entry.tableIds.push(table.id);\n    freeTablesByStart.set(key, entry);\n  }\n}\nconst roomy = [...freeTablesByStart.values()].filter(\n  (entry) => entry.tableIds.length >= minFreeTables,\n);\nif (roomy.length === 0) {\n  return [];\n}\nconst start = pick(roomy);\n\nreturn [{ json: { ...visit, tableId: pick(start.tableIds), startsAt: start.startsAt } }];"
      }
    },
    {
      "id": "8d2f6c1e-1a3b-4c5d-9e0f-000000000008",
      "name": "Book",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 200],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiBaseUrl }}/bookings",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Cookie",
              "value": "={{ $json.cookie }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ table_id: $json.tableId, starts_at: $json.startsAt, party_size: $json.partySize }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "8d2f6c1e-1a3b-4c5d-9e0f-000000000009",
      "name": "Cancel this time?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 420],
      "parameters": {
        "jsCode": "const visit = $input.first().json;\n\nreturn visit.action === 'cancel' ? [{ json: visit }] : [];"
      }
    },
    {
      "id": "8d2f6c1e-1a3b-4c5d-9e0f-000000000010",
      "name": "List my bookings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 420],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.apiBaseUrl }}/bookings",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Cookie",
              "value": "={{ $json.cookie }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "8d2f6c1e-1a3b-4c5d-9e0f-000000000011",
      "name": "Pick a booking to cancel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 420],
      "parameters": {
        "jsCode": "const visit = $('Cancel this time?').first().json;\nconst cancelCutoffMs = 30 * 60 * 1000;\nconst cancellable = $input\n  .all()\n  .map((item) => item.json)\n  .filter(\n    (booking) =>\n      booking.status === 'CONFIRMED' && Date.parse(booking.starts_at) > Date.now() + cancelCutoffMs,\n  );\nif (cancellable.length === 0) {\n  return [];\n}\nconst choice = cancellable[Math.floor(Math.random() * cancellable.length)];\n\nreturn [{ json: { ...visit, bookingId: choice.id } }];"
      }
    },
    {
      "id": "8d2f6c1e-1a3b-4c5d-9e0f-000000000012",
      "name": "Cancel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 420],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiBaseUrl }}/bookings/{{ $json.bookingId }}/cancel",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Cookie",
              "value": "={{ $json.cookie }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "8d2f6c1e-1a3b-4c5d-9e0f-000000000013",
      "name": "Check the booking answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 200],
      "parameters": {
        "jsCode": "// 409 is a lost visit: the slot was taken meanwhile or the bot holds an overlapping booking.\nconst { statusCode, body } = $input.first().json;\nif (![201, 409].includes(statusCode)) {\n  throw new Error(`Booking answered ${statusCode}: ${JSON.stringify(body)}`);\n}\n\nreturn $input.all();"
      }
    },
    {
      "id": "8d2f6c1e-1a3b-4c5d-9e0f-000000000014",
      "name": "Check the cancel answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 420],
      "parameters": {
        "jsCode": "// 409 is a lost race: the booking was cancelled or reached the cutoff meanwhile.\nconst { statusCode, body } = $input.first().json;\nif (![200, 409].includes(statusCode)) {\n  throw new Error(`Cancel answered ${statusCode}: ${JSON.stringify(body)}`);\n}\n\nreturn $input.all();"
      }
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [[{ "node": "Plan the visit", "type": "main", "index": 0 }]]
    },
    "Plan the visit": {
      "main": [[{ "node": "Log in", "type": "main", "index": 0 }]]
    },
    "Log in": {
      "main": [[{ "node": "Keep the session", "type": "main", "index": 0 }]]
    },
    "Keep the session": {
      "main": [
        [
          { "node": "Book this time?", "type": "main", "index": 0 },
          { "node": "Cancel this time?", "type": "main", "index": 0 }
        ]
      ]
    },
    "Book this time?": {
      "main": [[{ "node": "Search tables", "type": "main", "index": 0 }]]
    },
    "Search tables": {
      "main": [[{ "node": "Pick a free slot", "type": "main", "index": 0 }]]
    },
    "Pick a free slot": {
      "main": [[{ "node": "Book", "type": "main", "index": 0 }]]
    },
    "Book": {
      "main": [[{ "node": "Check the booking answer", "type": "main", "index": 0 }]]
    },
    "Cancel this time?": {
      "main": [[{ "node": "List my bookings", "type": "main", "index": 0 }]]
    },
    "List my bookings": {
      "main": [[{ "node": "Pick a booking to cancel", "type": "main", "index": 0 }]]
    },
    "Pick a booking to cancel": {
      "main": [[{ "node": "Cancel", "type": "main", "index": 0 }]]
    },
    "Cancel": {
      "main": [[{ "node": "Check the cancel answer", "type": "main", "index": 0 }]]
    }
  }
}
