{
  "permissions": {
    "allow": [
  "Bash(uv run lint-imports*)",
  "Bash(uv run pytest*)",
  "Bash(uv run mypy *)",
  "Bash(uv run ruff check*)",
  "Bash(uv run ruff format --check*)",
  "Bash(actionlint*)"
],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git stash *)",
      "Bash(git reset *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git rm *)",
      "Bash(rm *)",
      "Bash(alembic upgrade *)",
      "Bash(ruff format *)",
      "Bash(black *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)"
    ]
  }
}
