backend-showcase-dev.duckdns.org {
	reverse_proxy app-dev-api:8000
}

backend-showcase-grafana.duckdns.org {
	# An anonymous Viewer may create short links, and each one is a row in Grafana's database
	# that never expires; the data volume is shared with prod.
	respond /api/short-urls* 403
	reverse_proxy grafana:3000
}
