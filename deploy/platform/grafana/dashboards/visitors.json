    {
      "id": 2,
      "type": "stat",
      "title": "Regulars vs occasional",
      "description": "Visitors with at least the chosen number of visits per 7 days of the range are regulars; the rest are occasional.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "restaurant-dev"
      },
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "restaurant-dev"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH visitors AS (\n  SELECT b.user_id, count(*) AS visits\n  FROM bookings b\n  JOIN dining_tables t ON t.id = b.table_id\n  WHERE $__timeFilter(b.starts_at)\n    AND b.status = 'CONFIRMED'\n    AND t.location_id IN ($location)\n  GROUP BY b.user_id\n), weeks AS (\n  SELECT extract(epoch FROM $__timeTo()::timestamptz - $__timeFrom()::timestamptz) / 604800 AS in_range\n)\nSELECT count(*) FILTER (WHERE visits >= $regular_threshold * weeks.in_range) AS \"Regulars\",\n       count(*) FILTER (WHERE visits < $regular_threshold * weeks.in_range) AS \"Occasional\"\nFROM visitors, weeks"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Repeat rate",
      "description": "Share of visitors with two or more visits in the range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "restaurant-dev"
      },
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "restaurant-dev"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH visitors AS (\n  SELECT b.user_id, count(*) AS visits\n  FROM bookings b\n  JOIN dining_tables t ON t.id = b.table_id\n  WHERE $__timeFilter(b.starts_at)\n    AND b.status = 'CONFIRMED'\n    AND t.location_id IN ($location)\n  GROUP BY b.user_id\n)\nSELECT count(*) FILTER (WHERE visits >= 2)::float / NULLIF(count(*), 0) AS \"Repeat rate\"\nFROM visitors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
