  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Party size distribution over time",
      "description": "Confirmed bookings by the day they start, split by party size. Parties of 5 to 8 come through a request that staff approve.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "restaurant-dev"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "restaurant-dev"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('day', b.starts_at, 'Asia/Tbilisi') AS time,\n       count(*) FILTER (WHERE b.party_size = 1) AS \"1 guest\",\n       count(*) FILTER (WHERE b.party_size = 2) AS \"2 guests\",\n       count(*) FILTER (WHERE b.party_size = 3) AS \"3 guests\",\n       count(*) FILTER (WHERE b.party_size = 4) AS \"4 guests\",\n       count(*) FILTER (WHERE b.party_size > 4) AS \"5 to 8 guests\"\nFROM bookings b\nJOIN dining_tables t ON t.id = b.table_id\nWHERE $__timeFilter(b.starts_at)\n  AND b.status = 'CONFIRMED'\n  AND t.location_id IN ($location)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
