    },
    {
      "id": 4,
      "type": "table",
      "title": "Top visitors by bookings",
      "description": "The ten visitors with the most confirmed bookings in the range, by first and last name.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "restaurant-dev"
      },
      "gridPos": {
        "h": 12,
        "w": 14,
        "x": 10,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "restaurant-dev"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT u.first_name || ' ' || u.last_name AS \"Visitor\", count(*) AS \"Visits\"\nFROM bookings b\nJOIN dining_tables t ON t.id = b.table_id\nJOIN users u ON u.id = b.user_id\nWHERE $__timeFilter(b.starts_at)\n  AND b.status = 'CONFIRMED'\n  AND t.location_id IN ($location)\nGROUP BY u.id\nORDER BY 2 DESC, 1\nLIMIT 10"
        }
      ],
      "fieldConfig": {
