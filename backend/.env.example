# Copy to backend/.env for local runs; every settings class reads it when it exists.
# Containers get real environment variables instead. Tests never read .env.

# App
APP_ENVIRONMENT=local                     # local | dev | staging | prod; only local returns debug_code
APP_FRONTEND_URL=https://family-rest.vercel.app

# Database (defaults match backend/compose.yml)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_USER=app
DATABASE_PASSWORD=app
DATABASE_NAME=app
DATABASE_PROBE_TIMEOUT_SECONDS=1          # /health database check; under the 2 s urlopen timeout of the Dockerfile HEALTHCHECK

# Email (Gmail SMTP with STARTTLS; empty EMAIL_USERNAME means emails are only logged)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=                           # 16-char app password, no spaces
EMAIL_SENDER=                             # the same Gmail address as EMAIL_USERNAME

# Google OAuth (Google Auth Platform > Clients, Web application)
# Empty means Google sign-in is unavailable. Authorized redirect URI: {APP_FRONTEND_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth
AUTH_VERIFICATION_CODE_TTL_MINUTES=10
AUTH_RESEND_COOLDOWN_SECONDS=60
AUTH_MAX_CODE_ATTEMPTS=5
AUTH_MAX_CODES_PER_HOUR=5
AUTH_MAX_RESET_CODES_PER_DAY=10
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_MINUTES=5
AUTH_OAUTH_STATE_MAX_AGE_SECONDS=600      # signed oauth_state cookie for the OAuth round trip
AUTH_OAUTH_STATE_COOKIE_PATH=/api/v1/auth

# Booking (every date and slot rule uses BOOKING_TIMEZONE)
BOOKING_TIMEZONE=Asia/Tbilisi
BOOKING_FIRST_SLOT=10:00
BOOKING_LAST_SLOT=21:30
BOOKING_SLOT_MINUTES=30
BOOKING_DURATION_MINUTES=90
BOOKING_HORIZON_DAYS=30
BOOKING_CANCEL_CUTOFF_MINUTES=30
BOOKING_MAX_ONLINE_PARTY_SIZE=4           # caps the party and table capacity of instant bookings
BOOKING_MAX_REQUEST_PARTY_SIZE=8          # larger parties send a request; max 8 (party_size CHECK)
BOOKING_MAX_DURATION_MINUTES=180          # stays run from DURATION to this in SLOT_MINUTES steps
BOOKING_CLOSING_TIME=23:00                # every stay must end by then on the same local day
BOOKING_PREORDER_LOCK_MINUTES=30          # invites and pre-order close this long before the start
BOOKING_GUEST_TOKEN_TTL_DAYS=31           # guest_token cookie of guests without an account
BOOKING_GUEST_COOKIE_PATH=/
BOOKING_AUTO_REJECT_LEAD_MINUTES=120      # pending requests this close to the start are rejected
BOOKING_AUTO_REJECT_INTERVAL_SECONDS=60   # how often the API process looks for them

# Pre-order (closes at BOOKING_PREORDER_LOCK_MINUTES before the start)
PREORDER_MAX_ITEM_QUANTITY=20             # most portions of one dish in a participant's cart

# Notifications (decision emails; these domains get none)
NOTIFICATIONS_SKIP_EMAIL_DOMAINS=["example.com"]

# Cleanup (deletes expired refresh tokens, superseded verification codes and inactive assistant sessions; the newest code of a user and purpose always stays)
CLEANUP_INTERVAL_SECONDS=3600             # how often the API process runs it

# OpenAI (the assistant's model provider; empty OPENAI_API_KEY means the assistant routes answer 503)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini                 # chat model name as the OpenAI API knows it
OPENAI_MAX_OUTPUT_TOKENS=1024             # most tokens one model call may produce
OPENAI_REQUEST_TIMEOUT_SECONDS=60         # bounds one model call, not a whole turn
# The three prices must be OPENAI_MODEL's own, from https://developers.openai.com/api/docs/pricing;
# the defaults are gpt-4.1-mini's, so changing the model alone makes the budget undercount.
OPENAI_INPUT_PRICE_PER_MILLION_USD=0.40         # price of OPENAI_MODEL per million input tokens, cached ones excluded
OPENAI_CACHED_INPUT_PRICE_PER_MILLION_USD=0.10  # price per million cached input tokens
OPENAI_OUTPUT_PRICE_PER_MILLION_USD=1.60        # price per million output tokens

# Assistant (chat sessions on the website; verified users only)
ASSISTANT_SESSION_TTL_DAYS=7              # a session without a new message for this long is deleted
ASSISTANT_HISTORY_MESSAGES=20             # latest messages of the session the model sees, the new one included
ASSISTANT_MAX_ROUNDS=5                    # most model calls in one turn; past it a fixed fallback text answers
ASSISTANT_MAX_TOOL_CALLS=15               # most tool calls in one turn, counted across rounds
ASSISTANT_TURN_TIMEOUT_SECONDS=240        # wall-clock cap of one turn; past it the stream ends with an error
ASSISTANT_TOOL_RESULT_MAX_CHARS=8000      # a longer tool result is cut before it reaches the model
ASSISTANT_DAILY_BUDGET_USD=1.0            # global soft spend per local day (BOOKING_TIMEZONE); past it new turns get 429
ASSISTANT_TURNS_PER_MINUTE=10             # global cap of user messages in the last 60 s; past it new turns get 429
ASSISTANT_ACTION_TTL_HOURS=24             # a confirmation card not applied or cancelled within this long reads as expired

# Tokens (TOKEN_SECRET_KEY is required, at least 32 characters: openssl rand -hex 32)
TOKEN_SECRET_KEY=
TOKEN_ALGORITHM=HS256                     # HS256 | HS384 | HS512; HS384 and HS512 need a 48- and 64-byte key
TOKEN_ACCESS_TTL_MINUTES=15
TOKEN_REFRESH_TTL_DAYS=30
TOKEN_ACCESS_COOKIE_PATH=/
TOKEN_REFRESH_COOKIE_PATH=/api/v1/auth

# Media (OCI Object Storage; the write keys are only for the local menu seed, never on the server)
MEDIA_PUBLIC_BASE_URL=https://objectstorage.eu-frankfurt-1.oraclecloud.com/n/fr76arfm8eim/b/backend-showcase-media-dev/o
MEDIA_S3_ENDPOINT_URL=https://fr76arfm8eim.compat.objectstorage.eu-frankfurt-1.oci.customer-oci.com
MEDIA_REGION=eu-frankfurt-1
MEDIA_BUCKET=backend-showcase-media-dev
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
