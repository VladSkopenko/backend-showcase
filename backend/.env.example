# Copy to backend/.env for local runs; every settings class reads it when it exists.
# Containers get real environment variables instead. Tests never read .env.

# App
APP_NAME=backend-showcase
APP_ENVIRONMENT=local                     # local | dev | staging | prod; only local returns debug_code
APP_FRONTEND_URL=https://family-rest.vercel.app
APP_BACKEND_URL=https://backend-showcase-dev.duckdns.org

# Database (defaults match backend/compose.yml)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_USER=app
DATABASE_PASSWORD=app
DATABASE_NAME=app
DATABASE_PROBE_TIMEOUT_SECONDS=1          # /health database check; under the 2 s urlopen timeout of the Dockerfile HEALTHCHECK

# Email (Gmail SMTP with STARTTLS; empty EMAIL_USERNAME means emails are only logged)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=                           # 16-char app password, no spaces
EMAIL_SENDER=                             # the same Gmail address as EMAIL_USERNAME

# Google OAuth (Google Auth Platform > Clients, Web application)
# Empty means Google sign-in is unavailable. Authorized redirect URI: {APP_FRONTEND_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth
AUTH_VERIFICATION_CODE_TTL_MINUTES=10
AUTH_RESEND_COOLDOWN_SECONDS=60
AUTH_MAX_CODE_ATTEMPTS=5
AUTH_MAX_CODES_PER_HOUR=5
AUTH_MAX_RESET_CODES_PER_DAY=10
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_MINUTES=5
AUTH_OAUTH_STATE_MAX_AGE_SECONDS=600      # signed oauth_state cookie for the OAuth round trip
AUTH_OAUTH_STATE_COOKIE_PATH=/api/v1/auth

# Tokens (TOKEN_SECRET_KEY is required, at least 32 characters: openssl rand -hex 32)
TOKEN_SECRET_KEY=
TOKEN_ALGORITHM=HS256                     # HS256 | HS384 | HS512; HS384 and HS512 need a 48- and 64-byte key
TOKEN_ACCESS_TTL_MINUTES=15
TOKEN_REFRESH_TTL_DAYS=30
TOKEN_ACCESS_COOKIE_PATH=/
TOKEN_REFRESH_COOKIE_PATH=/api/v1/auth

# Media (OCI Object Storage; the write keys are only for the local menu seed, never on the server)
MEDIA_PUBLIC_BASE_URL=https://objectstorage.eu-frankfurt-1.oraclecloud.com/n/fr76arfm8eim/b/backend-showcase-media-dev/o
MEDIA_S3_ENDPOINT_URL=https://fr76arfm8eim.compat.objectstorage.eu-frankfurt-1.oci.customer-oci.com
MEDIA_REGION=eu-frankfurt-1
MEDIA_BUCKET=backend-showcase-media-dev
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
